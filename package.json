{
  "name": "save-and-save-as",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host localhost --port 5173 --strictPort",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test:detection": "node tests/document-detection.regression.mjs",
    "test:opencv-loader": "node tests/opencv-loader.regression.mjs",
    "test:scanner-reliability": "node tests/scanner-reliability.regression.mjs",
    "test:scan-summary": "node tests/scan-summary.regression.mjs",
    "test:routing": "node tests/spa-routing.regression.mjs",
    "test:cloud-library": "node tests/cloud-library.regression.mjs",
    "test:library-management": "node tests/library-management.regression.mjs",
    "test:library-management-v2": "node tests/library-management-v2.regression.mjs",
    "test:auth-password": "node tests/auth-password.regression.mjs",
    "test:account-profile": "node tests/account-profile.regression.mjs",
    "test:google-oauth-safety": "node --experimental-strip-types tests/google-oauth-safety.regression.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "latest",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jspdf": "^4.2.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
